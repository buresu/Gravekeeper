[Desktop Entry]
Type=Application
Name={{name}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}}
Icon={{icon}}
Categories={{categories}}
Terminal=false
# Matches the Wayland app_id / X11 WM_CLASS, so the window gets this entry's icon.
StartupWMClass=gravekeeper
Keywords=supervisor;process;monitor;restart;
